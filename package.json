{
  "name": "haituo-platform",
  "productName": "海拓商业版",
  "version": "0.1.1",
  "description": "海拓商业版 - 多语言翻译与多渠道消息聚合平台",
  "author": "海拓",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "dotenv": "^18.0.9",
    "ws": "^8.22.0"
  },
  "build": {
    "appId": "com.haituo.platform",
    "productName": "海拓商业版",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!.env",
      "!.env.local",
      "!.env.*.local",
      "!*.tmp.js",
      "!*.log"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "海拓商业版",
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "artifactName": "海拓商业版-Setup-${version}.exe",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
