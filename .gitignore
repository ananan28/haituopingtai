# 依赖
node_modules/
supabase/.temp/
# Signal 原生依赖（随源码迁入，非 npm 管理；main/renderer 均按此解析）
!signal/node_modules/

# 构建产物
dist/
dist-*/
out/
build/
!signal/build/
release/

# 密钥与环境变量（真实 key 绝不入库）
.env
.env.*
!.env.example

# 日志
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 临时验证脚本
*.tmp.js

# 系统文件
.DS_Store
Thumbs.db

# Required JavaScript entrypoints of vendored Signal dependencies.
!signal/node_modules/**/dist/
!signal/node_modules/**/dist/**
